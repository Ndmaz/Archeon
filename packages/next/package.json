{
  "name": "@archeon/next",
  "version": "0.0.1",
  "description": "Next.js route-handler adapter for Archeon applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
