{
  "name": "@archeon/core",
  "version": "0.1.0",
  "description": "Framework-neutral operation runtime for TypeScript applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ndmaz/Archeon.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Ndmaz/Archeon#readme",
  "bugs": {
    "url": "https://github.com/Ndmaz/Archeon/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
