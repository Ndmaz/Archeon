{
  "name": "archeon",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm --filter @archeon-ts/core build && pnpm --filter @archeon-ts/next build",
    "typecheck": "pnpm --filter @archeon-ts/core typecheck && pnpm --filter @archeon-ts/next typecheck",
    "test": "pnpm --filter @archeon-ts/core test && pnpm --filter @archeon-ts/next test",
    "test:packages": "node scripts/package-smoke.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
